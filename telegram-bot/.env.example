TELEGRAM_TOKEN=<set-me>
# For async operations, use an async PostgreSQL driver.
# Python < 3.14:  postgresql+asyncpg://user:pass@host:port/db
# Python >= 3.14: postgresql+psycopg://user:pass@host:port/db
DB_URL=postgresql+asyncpg://coord_user:coord_pass@localhost:5432/coord_db

# --- Connection budget (docs/CONNECTION_BUDGET.md) ---------------------------
# Peak server connections = DB_PROCESSES × (DB_POOL_SIZE + DB_MAX_OVERFLOW).
# Keep it under max_connections − superuser_reserved_connections − 5.
# Stock PostgreSQL (max_connections=100, 3 reserved) leaves 92:
#   1 process  : 10 + 20  (defaults)          = 30
#   2 processes: 10 + 20 each                 = 60
#   4 processes: 10 + 10 each                 = 80
#   6+ processes: use PgBouncer (DB_PGBOUNCER=true) or raise max_connections.
# Startup logs "Connection budget OK" or "Connection budget EXCEEDED".
# DB_PROCESSES=1            # bot replicas + API workers sharing this database
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30        # seconds to wait for a free connection, then fail
# Recycle below the shortest idle timeout between app and database (load
# balancer, cloud proxy, PgBouncer client_idle_timeout). Set DB_IDLE_TIMEOUT to
# that value and startup checks the relation.
# DB_POOL_RECYCLE=1800
# DB_IDLE_TIMEOUT=
# Behind PgBouncer in transaction mode: disables prepared-statement caches.
# DB_PGBOUNCER=false

# AI_ENDPOINT must be an OpenAI-COMPATIBLE base URL. The client POSTs to
# <AI_ENDPOINT>/chat/completions and GETs <AI_ENDPOINT>/models.
#
# Google Gemini (current deployment) — note the /openai/ compatibility path.
# Do NOT use the native ".../v1beta/models/<model>:generateContent" URL; it
# does not serve /chat/completions and every AI call will fail into fallbacks.
AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-flash-latest
AI_API_KEY=<set-me>

# Local OpenAI-compatible server (llama.cpp, vLLM, Ollama) instead:
# AI_ENDPOINT=http://127.0.0.1:8080/v1/
# AI_MODEL=qwen/qwen3-coder-next
# AI_API_KEY=dummy-key

# Optional
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_LEVEL_TELEGRAM=INFO
LOG_LEVEL_HTTPX=WARNING

# Statements one update/request may run before "Query budget exceeded" is logged.
# QUERY_BUDGET=40

# Shared read cache for language preferences and group settings (core/cache.py).
# Needs REDIS_URL with more than one instance. false = always read the database.
# CACHE_ENABLED=true
# CACHE_TTL=300

# Shared state is required when more than one bot instance is running.
REDIS_URL=redis://localhost:6379/0

# Set to true after WEBHOOK_URL points to a public HTTPS endpoint.
WEBHOOK_MODE=false
WEBHOOK_URL=https://bot.example.com/telegram-webhook
# WEBHOOK_PORT=8443
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=<generate-a-strong-random-secret>
